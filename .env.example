# Team password for the app (everyone at the booth shares it)
APP_PASSWORD=change-me
# Similarweb REST API key (Settings > API in the Similarweb account)
SW_API_KEY=
# Semrush API key (Semrush > Subscription info > API units)
SEMRUSH_API_KEY=
# Optional: a Google Apps Script web-app URL that appends each saved row to a Sheet
LOG_WEBHOOK_URL=
# Optional: override Similarweb paths if your account's API reference differs
SW_AI_OVERVIEW_PATH=/v1/website/{domain}/ai-traffic/overview
SW_AI_LANDING_PATH=/v1/website/{domain}/ai-traffic/landing-pages
SW_VISITS_PATH=/v1/website/{domain}/total-traffic-and-engagement/visits
# Set to 1 to run with sample data and no API keys (UI testing)
MOCK=0
PORT=8080
DATA_DIR=./data
